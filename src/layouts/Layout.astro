---
import '../styles/global.css';
import '@fontsource-variable/maven-pro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import Image from 'astro/components/Image.astro';
import logo from '../assets/logo.svg';
interface Props {
	title: string;
	lang: 'et' | 'en';
	description?: string;
}

const { title, lang, description } = Astro.props;

const defaultDescription = lang === 'et'
	? 'Maand Solutions – Tartus asuv tarkvaraarenduse ettevõte. Loome nutikaid ja terviklikke tarkvaralahendusi, tootestrateegiat ning veebi- ja mobiilirakendusi.'
	: 'Maand Solutions – Software development company based in Tartu, Estonia. We build tailor-made software solutions, product strategies, and web & mobile applications.';

const metaDescription = description || defaultDescription;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={metaDescription} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}maand_favicon.png`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="text-black">
	<header class="sticky top-0 bg-black z-50 shadow-xs text-primary w-full">
		<nav class="px-4 py-4 md:py-5">
			<div class="flex flex-col gap-4 items-center md:flex-row md:justify-between md:items-center">
				<div>
					<a href="#">
						<Image src={logo} alt="maand" class="h-8 md:h-10 w-auto" />
					</a>
				</div>
				<ul class="flex flex-wrap gap-3 md:gap-4 font-semibold items-center justify-center md:justify-end text-sm md:text-base">
					<li><a href="#services">{lang === 'et' ? 'Teenused' : 'Services'}</a></li>
					<li><a href="#about">{lang === 'et' ? 'Meist' : 'About us'}</a></li>
					<li><a href="#contact">{lang === 'et' ? 'Kontakt' : 'Contact'}</a></li>
					<li><LanguageSwitcher lang={lang} /></li>
				</ul>
			</div>
		</nav>
	</header>
		<slot />
	</body>
</html>

<style>
:global(html) {
	font-family: 'Maven Pro Variable', sans-serif;
	color: hsl(var(--colour-text-hue) var(--colour-text-saturation) var(--colour-text-luminance));
	scroll-behavior: smooth;
}
@media (prefers-reduced-motion: reduce) {
		:global(html) {
		scroll-behavior: auto;
	}
}
</style>
